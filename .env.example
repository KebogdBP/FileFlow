NEXT_PUBLIC_APP_NAME=FileFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FILEFLOW_ENVIRONMENT=development
FILEFLOW_WEB_BASE_URL=http://localhost:3000
# Configure these in production to enable password reset emails.
# FILEFLOW_SMTP_HOST=smtp.example.com
# FILEFLOW_SMTP_PORT=587
# FILEFLOW_SMTP_USERNAME=
# FILEFLOW_SMTP_PASSWORD=
# FILEFLOW_SMTP_FROM_EMAIL=no-reply@fileflow.pro

# Social import resilience. Keep credentials and proxy URLs server-side only.
# FILEFLOW_SOCIAL_IMPORT_COOKIES_FILE=/run/secrets/social-import-cookies.txt
# FILEFLOW_SOCIAL_IMPORT_POT_PROVIDER_URL=http://pot-provider:4416
# FILEFLOW_SOCIAL_IMPORT_PROXY_URL=
# FILEFLOW_SOCIAL_IMPORT_ALLOW_REMOTE_EJS=true
# Set before the API/worker starts only when a broken third-party yt-dlp plugin
# must be bypassed. Do not combine with the PO-token provider above.
# FILEFLOW_SOCIAL_IMPORT_DISABLE_PLUGINS=false

# AI subtitle assistant. Keep the key server-side; never expose it as NEXT_PUBLIC_*.
# FILEFLOW_DEEPSEEK_API_KEY=
# FILEFLOW_DEEPSEEK_BASE_URL=https://api.deepseek.com
# FILEFLOW_DEEPSEEK_MODEL=deepseek-v4-flash
# FILEFLOW_DAILY_AI_REQUESTS=20
