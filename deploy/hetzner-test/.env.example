# Public addresses.
FILEFLOW_API_HOST=api.fileflow.pro
FILEFLOW_WEB_HOST=fileflow.pro
FILEFLOW_WEB_ORIGIN=https://fileflow.pro
# Optional HTTP(S) or SOCKS egress proxy. Required if YouTube has blocked the VPS IP.
FILEFLOW_SOCIAL_IMPORT_PROXY_URL=

# Replace every value below. Do not commit the resulting .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=fileflow
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
