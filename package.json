{
  "name": "fileflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build && apps/api/.venv/bin/python -m compileall -q apps/api/src",
    "lint": "turbo lint && apps/api/.venv/bin/python -m ruff check apps/api",
    "typecheck": "turbo typecheck && apps/api/.venv/bin/python -m mypy --config-file apps/api/pyproject.toml",
    "test": "turbo test && apps/api/.venv/bin/python -m pytest -c apps/api/pyproject.toml apps/api/tests",
    "format": "prettier --write . && apps/api/.venv/bin/python -m ruff format apps/api",
    "format:check": "prettier --check . && apps/api/.venv/bin/python -m ruff format --check apps/api",
    "api:dev": "apps/api/.venv/bin/python -m uvicorn fileflow_api.main:app --app-dir apps/api/src --reload --port 8000",
    "api:worker:safety": "cd apps/api && .venv/bin/celery -A fileflow_api.jobs.worker:celery_app worker --queues safety --loglevel INFO",
    "api:setup": "python3 -m venv apps/api/.venv && apps/api/.venv/bin/python -m pip install -e './apps/api[dev]'",
    "clean": "turbo clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  }
}
